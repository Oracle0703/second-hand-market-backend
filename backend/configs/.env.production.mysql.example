APP_ENV=production
ADDR=:8080
DB_DRIVER=mysql
# This placeholder is intentionally rejected until it is replaced by a deployment secret.
DB_DSN='shm:replace-with-a-strong-db-password@tcp(127.0.0.1:3306)/second_hand_market?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai'

# Replace with strong random values in production.
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret

# For first startup on a fresh DB keep true, then set false.
AUTO_MIGRATE=true

FILE_STORAGE_PROVIDER=local
FILE_UPLOAD_LOCAL_DIR=/var/lib/second-hand-market/uploads
FILE_PUBLIC_BASE_URL=
FILE_UPLOAD_MAX_MB=10
FILE_UPLOAD_MULTIPART_MAX_MB=11
# This placeholder is intentionally rejected until it is replaced by a deployment secret.
FILE_UPLOAD_IP_HASH_SECRET=replace-with-a-strong-random-upload-ip-hmac-secret
FILE_UPLOAD_ANON_PRESIGN_PER_HOUR=20
FILE_UPLOAD_ANON_ACTIVE_FILES=5
FILE_UPLOAD_ANON_ACTIVE_MB=50
FILE_UPLOAD_MERCHANT_QUOTA_MB=2048
FILE_UPLOAD_GLOBAL_QUOTA_MB=20480
FILE_UPLOAD_CLEANUP_INTERVAL_SECONDS=300
FILE_UPLOAD_CLEANUP_BATCH_SIZE=50
FILE_UPLOAD_CLEANUP_CLAIM_TTL_SECONDS=600
FILE_UPLOAD_CLEANUP_GRACE_SECONDS=1800
# Documentation-only address: replace with the exact deployed proxy CIDR.
TRUSTED_PROXY_CIDRS=192.0.2.10/32
IMAGE_COMPRESS_TARGET_MB=20
IMAGE_PROCESSOR_DRIVER=vips
IMAGE_PROCESSOR_BIN=vips

# Buyer WeChat login mode: mock | real
BUYER_WECHAT_LOGIN_MODE=mock
BUYER_WECHAT_APP_ID=
BUYER_WECHAT_APP_SECRET=
BUYER_WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
BUYER_WECHAT_HTTP_TIMEOUT_SECONDS=5
