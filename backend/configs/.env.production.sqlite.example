APP_ENV=production
ADDR=:8080
DB_TARGET=local
DB_DRIVER=sqlite
DB_DSN=file:/var/lib/second-hand-market/app.db?cache=shared&_foreign_keys=on

# Generate two different values with: openssl rand -base64 48
# The placeholders below are intentionally rejected at startup.
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret

# The long-running API never migrates or seeds. Run the reviewed one-time
# commands before starting the API.
AUTO_MIGRATE=false
SEED_DEFAULTS=false
FILE_STORAGE_PROVIDER=local
FILE_UPLOAD_LOCAL_DIR=/var/lib/second-hand-market/uploads
FILE_PUBLIC_BASE_URL=
FILE_UPLOAD_MAX_MB=40
IMAGE_COMPRESS_TARGET_MB=20
IMAGE_PROCESSOR_DRIVER=vips
IMAGE_PROCESSOR_BIN=vips
REQUIRE_DETAIL_V1_PRODUCT_IMAGES=false

# Production rejects mock. Keep disabled until the existing mock-buyer
# migration is complete; real mode requires credentials and the exact endpoint.
BUYER_WECHAT_LOGIN_MODE=disabled
BUYER_WECHAT_APP_ID=
BUYER_WECHAT_APP_SECRET=
BUYER_WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
BUYER_WECHAT_HTTP_TIMEOUT_SECONDS=5

BUYER_DOUYIN_LOGIN_MODE=disabled
BUYER_DOUYIN_APP_ID=
BUYER_DOUYIN_APP_SECRET=
BUYER_DOUYIN_CODE2SESSION_URL=https://developer.toutiao.com/api/apps/v2/jscode2session
BUYER_DOUYIN_HTTP_TIMEOUT_SECONDS=5
