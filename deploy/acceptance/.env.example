# Copy this file to .env and replace every placeholder before starting Compose.
# Keep MYSQL_PASSWORD DSN-safe: use only letters, numbers, underscore, or hyphen.
MYSQL_DATABASE=second_hand_market_acceptance
MYSQL_USER=shm_acceptance
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Independent acceptance-only HMAC secret; generate with `openssl rand -hex 32`.
FILE_UPLOAD_IP_HASH_SECRET=

# Keep false while restoring and explicitly applying SQL migrations. The runbook
# changes this to true only for the final AutoMigrate compatibility restart.
AUTO_MIGRATE=false

ADMIN_BOOTSTRAP_USERNAME=acceptance_control
ADMIN_BOOTSTRAP_DISPLAY_NAME=Acceptance Control Admin
